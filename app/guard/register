'use client'
import { useState } from 'react'
import Link from 'next/link'
import { supabase } from '@/lib/supabase'

export default function GuardRegister(){
  const [form, setForm] = useState({
    name:'', mobile:'', password:'', gate_no:'1', shift:'Day', salary_per_day:'500'
  })
  const [photo, setPhoto] = useState<File|null>(null)
  const [loading, setLoading] = useState(false)

  const generateGuardId = ()=>{
    return 'G-' + Math.floor(100 + Math.random()*900).toString() + Date.now().toString().slice(-4)
  }

  const handleSubmit = async()=>{
    if(!form.name ||!form.mobile ||!form.password) return alert('Name/Mobile/Password bharo')
    if(form.mobile.length!=10) return alert('10 digit mobile')
    setLoading(true)

    let photoUrl = ''
    if(photo){
      const fileName = `guard_${Date.now()}_${photo.name}`
      const { data } = await supabase.storage.from('guard-photos').upload(fileName, photo)
      if(data){
        const { data: urlData } = supabase.storage.from('guard-photos').getPublicUrl(fileName)
        photoUrl = urlData.publicUrl
      }
    }

    const guard_id = generateGuardId()

    const { error } = await supabase.from('guards').insert({
      guard_id,
      name: form.name,
      mobile: form.mobile,
      password: form.password,
      gate_no: parseInt(form.gate_no),
      shift: form.shift,
      salary_per_day: parseInt(form.salary_per_day),
      photo_url: photoUrl,
      status: 'pending'
    })

    setLoading(false)
    if(error) alert('Error: '+error.message)
    else {
      alert(`✅ Guard Registered!\nGuard ID: ${guard_id}\nStatus: Pending Approval\nGate: ${form.gate_no}`)
      window.location.href='/'
    }
  }

  return (
    <div className="min-h-screen bg-[#0A0E1A] text-white">
      <header className="max-w-7xl mx-auto px-6 h- flex items-center justify-between border-b border-white/10">
        <Link href="/" className="text-[#D4AF37] text-sm">← Back to Home</Link>
        <div className="font-bold">Guard Registration <span className="text-white/40 text-xs">(3 per Gate)</span></div>
        <div></div>
      </header>

      <div className="max-w-2xl mx-auto px-6 py-8">
        <h1 className="text-2xl font-bold">Guard Registration at <span className="text-[#D4AF37]">Arihant Anchal</span></h1>
        <p className="text-white/50 text-sm mt-1">Premium security team — Gate 1 to 5 ke liye 3 members</p>

        <div className="mt-6 bg-[#151A27] border border-white/10 rounded- p-6 space-y-4">

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="text- tracking-widest text-white/40">GUARD NAME</label>
              <input value={form.name} onChange={e=>setForm({...form, name:e.target.value})} placeholder="Ram Singh" className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm"/>
            </div>
            <div>
              <label className="text- tracking-widest text-white/40">MOBILE</label>
              <input value={form.mobile} onChange={e=>setForm({...form, mobile:e.target.value})} placeholder="9876543210" className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm"/>
            </div>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="text- tracking-widest text-white/40">PASSWORD</label>
              <input type="password" value={form.password} onChange={e=>setForm({...form, password:e.target.value})} placeholder="1234" className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm"/>
            </div>
            <div>
              <label className="text- tracking-widest text-white/40">GATE NO (1-5)</label>
              <select value={form.gate_no} onChange={e=>setForm({...form, gate_no:e.target.value})} className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm">
                <option value="1" className="text-black">Gate 1 - Main</option>
                <option value="2" className="text-black">Gate 2</option>
                <option value="3" className="text-black">Gate 3</option>
                <option value="4" className="text-black">Gate 4</option>
                <option value="5" className="text-black">Gate 5</option>
              </select>
            </div>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="text- tracking-widest text-white/40">SHIFT</label>
              <select value={form.shift} onChange={e=>setForm({...form, shift:e.target.value})} className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm">
                <option className="text-black" value="Day">Day (8AM-8PM)</option>
                <option className="text-black" value="Night">Night (8PM-8AM)</option>
                <option className="text-black" value="Rotational">Rotational</option>
              </select>
            </div>
            <div>
              <label className="text- tracking-widest text-white/40">SALARY PER DAY</label>
              <input type="number" value={form.salary_per_day} onChange={e=>setForm({...form, salary_per_day:e.target.value})} className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm"/>
            </div>
          </div>

          <div>
            <label className="text- tracking-widest text-white/40">PHOTO (ID CARD KE LIYE)</label>
            <input type="file" accept="image/*" onChange={e=>setPhoto(e.target.files?.[0]||null)} className="mt-2 w-full h-12 rounded-2xl bg-white/5 border border-white/10 px-4 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-[#D4AF37] file:text-black file:text-xs file:font-bold"/>
          </div>

          <div className="bg-[#D4AF37]/10 border border-[#D4AF37]/20 rounded-xl p-3 text- text-[#D4AF37]/80">
            ℹ️ 3 Guards per Gate allowed. Admin approval ke baad hi login hoga. Photo attendance ke liye use hogi.
          </div>

          <button onClick={handleSubmit} disabled={loading} className="w-full h-12 rounded-full bg-[#D4AF37] text-black font-bold text-sm mt-2">
            {loading? 'Registering...' : 'Register Guard → Pending Approval'}
          </button>
        </div>
      </div>
    </div>
  )
}
